# Copy to .env.local (gitignored) and fill in real values. Never commit
# .env.local. Only the publishable/anon key belongs here — never the
# service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Development/demo only -- see mock_data_for_web/README.md. Never set
# NEXT_PUBLIC_USE_MOCK_DATA=true in a production deployment; it is also
# ignored automatically whenever NODE_ENV=production regardless of this
# value (src/lib/mock-data/config.ts). Leave unset or false by default.
NEXT_PUBLIC_USE_MOCK_DATA=false
# One of: default | empty | error | onboarding. Only read when the flag
# above is true.
NEXT_PUBLIC_MOCK_SCENARIO=default

# Local Demo Mode -- see demo/README.md. A separate, fuller interactive
# demo covering every portal module (Customers, Caregivers, Care
# Requests, Assignments, Visits, Reports, Staff & Access), with its own
# local demo sign-in and a "Reset Demo Data" control, backed by
# demo/demo-data.json. Never set NEXT_PUBLIC_DEMO_MODE=true in a
# production deployment; it is also ignored automatically whenever
# NODE_ENV=production regardless of this value (src/lib/demo/config.ts).
# Leave unset or false by default. Do not enable this at the same time as
# NEXT_PUBLIC_USE_MOCK_DATA above -- they are two separate, unrelated
# demo layers; Local Demo Mode supersedes the older mock-data layer for
# every module it covers.
NEXT_PUBLIC_DEMO_MODE=false

# HHH FastAPI backend URL (server-side only, not exposed to the browser).
# The portal forwards the user's Supabase access token to this backend
# for operations that need service-role access (staff emails, invites).
HHH_API_URL=https://api.hhh.foundation
